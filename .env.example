# Kopioi tämä tiedostoksi .env ja täytä arvot. Älä koskaan committaa .env-tiedostoa.

# --- Discord (pakolliset) ---
# Developer Portal → Bot → Reset Token
DISCORD_TOKEN=
# Developer Portal → General Information → Application ID
DISCORD_CLIENT_ID=
# Testipalvelimen ID (Discordissa: Developer Mode päälle → oikea klikkaus palvelimeen → Copy Server ID).
# Kun tämä on asetettu, komennot rekisteröidään vain tälle palvelimelle ja päivittyvät heti.
DISCORD_GUILD_ID=

# --- Tekoäly (tarvitaan vaiheesta 1 alkaen) ---
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Ostajan malli (oletus claude-opus-5-5). Nopeampi ja halvempi vaihtoehto: claude-haiku-5-5
ANTHROPIC_MODEL=
# low | medium | high | xhigh | max (oletus low = nopeimmat vastaukset)
ANTHROPIC_EFFORT=

# --- Ääni (tarvitaan vaiheesta 2 alkaen) ---
# deepgram | azure
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# elevenlabs | azure
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=northeurope
