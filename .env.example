# Kopioi tämä tiedostoksi .env ja täytä arvot. Älä koskaan committaa .env-tiedostoa.

# --- Discord (pakolliset) ---
# Developer Portal → Bot → Reset Token
DISCORD_TOKEN=
# Developer Portal → General Information → Application ID
DISCORD_CLIENT_ID=
# Testipalvelimen ID (Discordissa: Developer Mode päälle → oikea klikkaus palvelimeen → Copy Server ID).
# Kun tämä on asetettu, komennot rekisteröidään vain tälle palvelimelle ja päivittyvät heti.
DISCORD_GUILD_ID=

# --- Tilastot ---
# SQLite-tietokannan polku (oletus data/kauppa.sqlite). Kansio on .gitignoressa.
DATABASE_PATH=

# --- Päiväraja (suojaa tekoälyn käyttökuluilta) ---
# Pelejä per käyttäjä per vuorokausi, nollautuu keskiyöllä Suomen aikaa (oletus 20, 0 = ei rajaa)
DAILY_GAME_LIMIT=
# Pilkuilla erotetut Discord-käyttäjätunnukset, joita raja ei koske (esim. oma tunnuksesi testausta varten)
LIMIT_EXEMPT_USER_IDS=

# --- Tekoäly (tarvitaan vaiheesta 1 alkaen) ---
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Ostajan malli (oletus claude-opus-5-5). Nopeampi ja halvempi vaihtoehto: claude-haiku-5-5
ANTHROPIC_MODEL=
# low | medium | high | xhigh | max (oletus low = nopeimmat vastaukset)
ANTHROPIC_EFFORT=

# --- Ääni (/kauppa soita) ---
# Puhesynteesi: piper = paikallinen ja ilmainen (speech/server.py, asennus: npm run speech:setup)
#               azure = Azure Speech (vaatii AZURE_SPEECH_KEY:n, parempi äänenlaatu)
TTS_PROVIDER=piper
# Paikallisen puhepalvelun osoite (oletus http://127.0.0.1:5005)
SPEECH_URL=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=northeurope
# Puheentunnistus: whisper = paikallinen (botti kuuntelee äänipelissä myyjää) | off = ei kuuntelua
STT_PROVIDER=whisper
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# --- Sisältö ---
# Kansio, josta ostajat (personas.yaml) ja tuotteet (products.yaml) luetaan (oletus: content/)
CONTENT_DIR=
