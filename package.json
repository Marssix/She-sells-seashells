{
  "name": "kaupitse-botille",
  "version": "0.1.0",
  "private": true,
  "description": "Discord-peli: myy mitä tahansa tekoälyostajalle äänellä.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "deploy-commands": "tsx src/bot/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "play": "tsx src/cli/playtest.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
